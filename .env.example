# Recommended for reliable Facebook updates. Use a Page access token with
# permission to read the page's published content.
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Optional alternative name used by some deployments.
FACEBOOK_PAGE_ACCESS_TOKEN=

# Optional Playwright-compatible browser service for the HTML fallback.
FACEBOOK_BROWSER_WS_ENDPOINT=
FACEBOOK_ENABLE_LOCAL_BROWSER=true

# Shared store required for corrections to sync between Vercel instances.
KV_REST_API_URL=
KV_REST_API_TOKEN=
