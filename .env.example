# MongoDB is the persistent store used by the monitor and collaboration data.
MONGODB_URI=
MONGODB_DB_NAME=cortana

# Recommended for reliable Facebook updates. Use a Page access token with
# permission to read the page's published content.
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Optional alternative name used by some deployments.
FACEBOOK_PAGE_ACCESS_TOKEN=

# Optional Playwright-compatible browser service for the HTML fallback.
FACEBOOK_BROWSER_WS_ENDPOINT=
FACEBOOK_ENABLE_LOCAL_BROWSER=true

# Legacy shared-store variables are no longer required when using MongoDB.
# They may be left empty for Render.
KV_REST_API_URL=
KV_REST_API_TOKEN=
